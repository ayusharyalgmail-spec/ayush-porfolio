# Public (safe for the browser): Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# No service-role key is needed or used. Never add one to client code.
# Optional spam protection (Cloudflare Turnstile). When both are set the contact form requires the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
